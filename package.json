{
  "name": "@huatalk/butterfly-effect-skill",
  "version": "0.6.0",
  "packageManager": "npm@11.6.2",
  "description": "Detect task-artifact drift, recommend where an AI session should rewind, and generate a revised prompt for continuing from there.",
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "prompt-engineering",
    "retrospective",
    "hindsight",
    "rewind",
    "trajectory-drift",
    "drift-diagnosis",
    "butterfly-effect",
    "research",
    "writing",
    "design",
    "planning",
    "operations"
  ],
  "license": "MIT",
  "author": {
    "name": "HuaTalk",
    "url": "https://github.com/HuaTalk"
  },
  "homepage": "https://github.com/HuaTalk/butterfly-effect-skill",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HuaTalk/butterfly-effect-skill.git"
  },
  "bugs": {
    "url": "https://github.com/HuaTalk/butterfly-effect-skill/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "AGENTS.md",
    "CONTEXT.md",
    "skills/",
    "scripts/",
    ".claude-plugin/",
    "docs/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "README-zh.md"
  ],
  "scripts": {
    "test": "node --test scripts/check-versions.test.js && node scripts/check-repository.js",
    "check": "node scripts/check-repository.js",
    "check:install": "node scripts/check-install.js",
    "check:package": "node scripts/check-package.js",
    "check:skill": "node scripts/check-skill-contract.js",
    "check:versions": "node scripts/check-versions.js",
    "release:check": "npm test && npm publish --dry-run --ignore-scripts --access public --registry=https://registry.npmjs.org/",
    "prepublishOnly": "npm test"
  }
}
